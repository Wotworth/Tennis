            <clip-path android:pathData="M12,3.1 C9.5,3.1 7.7,5.4 7.7,8.3 C7.7,11.2 9.5,13.5 12,13.5 C14.5,13.5 16.3,11.2 16.3,8.3 C16.3,5.4 14.5,3.1 12,3.1 Z" />
