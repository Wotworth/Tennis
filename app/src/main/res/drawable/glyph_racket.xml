        <path android:fillColor="#FFFFFFFF" android:pathData="M9.2,13.4 L10.3,12.8 L12.6,16.4 L11.4,16.4 Z M14.8,13.4 L13.7,12.8 L11.4,16.4 L12.6,16.4 Z" />
