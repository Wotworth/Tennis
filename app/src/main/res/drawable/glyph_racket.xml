        <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
            android:pathData="M12,1.6 C15.4,1.6 17.8,4.6 17.8,8.3 C17.8,12 15.4,15 12,15 C8.6,15 6.2,12 6.2,8.3 C6.2,4.6 8.6,1.6 12,1.6 Z M12,3.1 C9.5,3.1 7.7,5.4 7.7,8.3 C7.7,11.2 9.5,13.5 12,13.5 C14.5,13.5 16.3,11.2 16.3,8.3 C16.3,5.4 14.5,3.1 12,3.1 Z" />
