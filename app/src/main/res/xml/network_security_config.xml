<?xml version="1.0" encoding="utf-8"?>
<!-- PHO-23: HTTPS only, system certificates only. The only host contacted is api.anthropic.com (ClaudeReader). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
